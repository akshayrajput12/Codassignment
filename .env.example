# COD Compass Environment Configuration

# Optional: Google Gemini API Key for live AI assessment and reply intent classification.
# If not provided, the application automatically runs in Offline Fixture Mode with deterministic mock AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# SQLite Database File Path (Default: data/sqlite.db)
DATABASE_URL=data/sqlite.db

# Node Environment
NODE_ENV=development
